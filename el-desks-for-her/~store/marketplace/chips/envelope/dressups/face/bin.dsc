/* waste bin · cubish black can (not manila, not cork) */
.nb-win.kind-trash .trash-lid {
  background:
    linear-gradient(180deg, #4a4a4e 0%, #2a2a2e 42%, #161618 100%);
  border-color: #050506;
}
.nb-win.kind-trash .trash-body {
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0 8px,
      rgba(0, 0, 0, 0.22) 8px 9px
    ),
    linear-gradient(105deg, #141416 0%, #2c2c32 22%, #1a1a1e 58%, #0c0c0e 100%);
  border-color: #050506;
  color: #f2eee4;
}
.nb-win.kind-trash .trash-word {
  color: #f4f0e4;
}
