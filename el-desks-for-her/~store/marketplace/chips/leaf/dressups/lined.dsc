/* leaf dress · lined · stack over _base */

.rx-paper.dress-lined .rx-paper-preview,
.rx-paper[data-paper="lined"] .rx-paper-preview {
  background-color: transparent;
  background-image: repeating-linear-gradient(
    transparent,
    transparent calc(1.45rem - 1px),
    rgba(200, 184, 152, 0.42) calc(1.45rem - 0.9px),
    rgba(200, 184, 152, 0.42) 1.45rem
  );
  background-attachment: local;
  background-origin: content-box;
}
