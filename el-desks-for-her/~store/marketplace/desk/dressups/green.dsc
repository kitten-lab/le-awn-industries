/* desk dress · green · felt of the house */

:root,
body.rx,
body.rx[data-felt="green"] {
  --felt: #1a3d2a;
  --felt2: #143224;
  --felt-hi: #2a5540;
  --felt-glow: rgba(60, 120, 80, 0.15);
  --rail: #0e1a14;
  --line: #3d5c48;
  --text: #e8f0e4;
  --dim: #9ab09a;
  --brass: #c4a060;
  --brass-hi: #e8d090;
  --focus-ring: rgba(232, 220, 170, 0.88);
  --focus-ring-outer: rgba(30, 70, 45, 0.55);
}
