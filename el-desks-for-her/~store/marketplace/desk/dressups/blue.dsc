/* desk dress · blue · felt of the house */

:root,
body.rx,
body.rx[data-felt="blue"] {
  --felt: #0c1e3a;
  --felt2: #061228;
  --felt-hi: #1a3a68;
  --felt-glow: rgba(40, 100, 180, 0.22);
  --rail: #0a1628;
  --line: #2a4060;
  --text: #d8e4f0;
  --dim: #7a90a8;
  --brass: #6a90c0;
  --brass-hi: #9ab8e0;
  --focus-ring: rgba(180, 210, 240, 0.88);
  --focus-ring-outer: rgba(20, 40, 80, 0.55);
}
