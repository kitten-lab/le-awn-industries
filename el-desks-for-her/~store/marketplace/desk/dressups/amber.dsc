/* desk dress · amber · scramble felt */

:root,
body.rx,
body.rx[data-felt="amber"] {
  --felt: #3a2410;
  --felt2: #1c1208;
  --felt-hi: #6a3e14;
  --felt-glow: rgba(200, 120, 30, 0.22);
  --rail: #24180c;
  --line: #6a4a28;
  --text: #f0e0c8;
  --dim: #a88860;
  --brass: #d4a04a;
  --brass-hi: #f0d080;
  --focus-ring: rgba(240, 200, 120, 0.88);
  --focus-ring-outer: rgba(60, 30, 8, 0.55);
}
