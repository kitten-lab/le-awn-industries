/* desk dress · velvet · felt of the house */

:root,
body.rx,
body.rx[data-felt="velvet"] {
  --felt: #3a1218;
  --felt2: #240c10;
  --felt-hi: #5a1c28;
  --felt-glow: rgba(140, 40, 60, 0.22);
  --rail: #14080c;
  --line: #5c3038;
  --text: #f0e4e6;
  --dim: #b0989c;
  --brass: #d0a878;
  --brass-hi: #ecd0a0;
  --focus-ring: rgba(232, 200, 180, 0.88);
  --focus-ring-outer: rgba(80, 20, 30, 0.55);
}
