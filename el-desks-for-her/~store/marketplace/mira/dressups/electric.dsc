/* mira dress · electric · terminal weather */

:root, body.rx {
  --mira-bg: #0055ff;
  --mira-bg-deep: #0044dd;
  --mira-fg: #ffffff;
  --mira-fg-bright: #ffffff;
  --mira-fg-dim: rgba(220, 232, 255, 0.72);
  --mira-border: #0033aa;
  --mira-bar: #003db8;
  --mira-line: rgba(255, 255, 255, 0.22);
  --mira-glow: rgba(0, 30, 100, 0.4);
  --mira-dot: #ffffff;
  --mira-shadow: rgba(0, 30, 100, 0.45);
  --mira-sel: rgba(255, 255, 255, 0.28);
}
