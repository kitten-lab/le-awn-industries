/* mira dress · phosphor · terminal weather */

:root, body.rx {
  --mira-bg: #0a120c;
  --mira-bg-deep: #061008;
  --mira-fg: #6dff7a;
  --mira-fg-bright: #9fffab;
  --mira-fg-dim: rgba(109, 255, 122, 0.65);
  --mira-border: #1a4024;
  --mira-bar: #061008;
  --mira-line: rgba(61, 255, 100, 0.28);
  --mira-glow: rgba(61, 200, 90, 0.22);
  --mira-dot: #6dff7a;
  --mira-shadow: rgba(0, 20, 8, 0.55);
  --mira-sel: rgba(61, 200, 90, 0.38);
}
