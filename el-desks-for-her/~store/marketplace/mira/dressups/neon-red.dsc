/* mira dress · neon-red · terminal weather */

:root, body.rx {
  --mira-bg: #14060a;
  --mira-bg-deep: #0a0002;
  --mira-fg: #ff3a4a;
  --mira-fg-bright: #ff6a75;
  --mira-fg-dim: rgba(255, 70, 85, 0.65);
  --mira-border: #5a1020;
  --mira-bar: #0c0004;
  --mira-line: rgba(255, 40, 60, 0.35);
  --mira-glow: rgba(255, 30, 50, 0.28);
  --mira-dot: #ff3a4a;
  --mira-shadow: rgba(0, 0, 0, 0.7);
  --mira-sel: rgba(255, 40, 60, 0.4);
}
