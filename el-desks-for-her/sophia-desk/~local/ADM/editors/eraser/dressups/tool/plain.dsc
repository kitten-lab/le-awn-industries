/* eraser dress · plain gum */
.tool-eraser[data-tool-dress="plain"] .tool-eraser-body {
  background: linear-gradient(165deg, #e8d8c0 0%, #c8b090 50%, #a89070 100%);
  border: 1px solid rgba(60, 45, 28, 0.45);
}
.tool-eraser[data-tool-dress="plain"] .tool-eraser-band {
  background: linear-gradient(180deg, #f2e6d4 0%, #d4c0a0 100%);
  border-bottom: 1px solid rgba(60, 45, 28, 0.2);
}
.tool-eraser[data-tool-dress="plain"] .tool-eraser-block {
  color: #3a3020;
  text-shadow: 0 1px 0 rgba(255, 250, 240, 0.3);
}
.tool-eraser[data-tool-dress="plain"] .tool-eraser-edge {
  background: linear-gradient(180deg, #b8a080 0%, #907858 100%);
  border-top: 1px solid rgba(40, 28, 16, 0.25);
}
