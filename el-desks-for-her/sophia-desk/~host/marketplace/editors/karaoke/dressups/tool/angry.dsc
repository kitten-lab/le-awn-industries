/* costume · dark angry (same machine · wrong weather) */
.tool-karaoke[data-tool-dress="angry"] {
  background: linear-gradient(165deg, #1a080c 0%, #0a0406 55%, #040204 100%);
  border: 2px solid #501018;
  box-shadow:
    0 3px 0 #020102,
    0 5px 14px rgba(80, 0, 10, 0.45),
    inset 0 0 20px rgba(80, 0, 10, 0.25);
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-tag {
  color: #ffc0c8;
  background: #e01830;
  box-shadow: 1px 1px 0 #400010;
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-slot {
  border-color: #802030;
  background: #040204;
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-face {
  color: #ff4060;
  text-shadow: 0 0 10px rgba(255, 40, 80, 0.45);
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-lever {
  background: linear-gradient(180deg, #e03050, #801020);
  box-shadow: 0 2px 0 #300810;
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-copy {
  background: linear-gradient(180deg, #c04040, #601018);
  box-shadow: 0 2px 0 #300808;
}
.tool-karaoke[data-tool-dress="angry"] .tool-karaoke-meta {
  color: #906060;
}
