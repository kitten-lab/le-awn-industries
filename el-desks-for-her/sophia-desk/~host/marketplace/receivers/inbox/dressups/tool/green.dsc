/* hermes · the.archivist */
.tool-inbox[data-tool-dress="green"] .tool-inbox-shell {
  background: linear-gradient(165deg, #3a6a58 0%, #2a4a40 48%, #1a322c 100%);
  border: 1px solid rgba(10, 30, 24, 0.75);
  box-shadow:
    inset 0 1px 0 rgba(180, 220, 200, 0.18),
    2px 5px 14px rgba(0, 0, 0, 0.4);
}
.tool-inbox[data-tool-dress="green"] .tool-inbox-slot {
  background: #0a100e;
  border: 1px solid rgba(0, 0, 0, 0.55);
  box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.65);
}
.tool-inbox[data-tool-dress="green"] .tool-inbox-word { color: #c8e8d4; }
.tool-inbox[data-tool-dress="green"] .tool-inbox-sub { color: #f0faf4; }
.tool-inbox[data-tool-dress="green"] .tool-inbox-count { color: #e8d090; }
.tool-inbox[data-tool-dress="green"] .tool-inbox-address { color: #b8e0c0; }
.tool-inbox[data-tool-dress="green"] .tool-inbox-flag {
  background: #c8e080; color: #1a2810; border: 1px solid rgba(40, 60, 20, 0.35);
}
