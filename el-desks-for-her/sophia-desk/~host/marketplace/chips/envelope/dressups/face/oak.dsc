/* deck · kraft / darker envelope (muted) */
.nb-win.kind-deck .env-flap {
  background: linear-gradient(180deg, #a89068 0%, #988058 55%, #887048 100%);
}
.nb-win.kind-deck .env-body {
  background: linear-gradient(165deg, #b8a078 0%, #a89068 45%, #988058 100%);
}
.nb-win.kind-deck .deck-open {
  background: linear-gradient(180deg, #b8a078 0%, #a89068 40%, #988058 100%);
}
