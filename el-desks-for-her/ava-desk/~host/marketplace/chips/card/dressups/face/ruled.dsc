/* card face · ruled index */
.tool-card[data-tool-dress="ruled"] {
  background:
    repeating-linear-gradient(
      180deg,
      #f6f1e6 0,
      #f6f1e6 1.05rem,
      #e8d8c8 1.05rem,
      #e8d8c8 calc(1.05rem + 1px)
    );
  border: 1px solid rgba(80, 60, 40, 0.4);
  box-shadow:
    0 1px 0 rgba(255, 255, 255, 0.45) inset,
    1px 2px 6px rgba(0, 0, 0, 0.16);
}
.tool-card[data-tool-dress="ruled"] .tool-card-title {
  background: rgba(246, 241, 230, 0.85);
}
