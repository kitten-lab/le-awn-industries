/* hermes · the.detective */
.tool-inbox[data-tool-dress="red"] .tool-inbox-shell {
  background: linear-gradient(165deg, #8a2838 0%, #5a1420 48%, #2a0a10 100%);
  border: 1px solid rgba(40, 8, 12, 0.8);
  box-shadow:
    inset 0 1px 0 rgba(255, 180, 190, 0.16),
    2px 5px 14px rgba(0, 0, 0, 0.45);
}
.tool-inbox[data-tool-dress="red"] .tool-inbox-slot {
  background: #0a0406;
  border: 1px solid rgba(0, 0, 0, 0.55);
  box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.7);
}
.tool-inbox[data-tool-dress="red"] .tool-inbox-word { color: #f0c8d0; }
.tool-inbox[data-tool-dress="red"] .tool-inbox-sub { color: #fff0f2; }
.tool-inbox[data-tool-dress="red"] .tool-inbox-count { color: #e8d090; }
.tool-inbox[data-tool-dress="red"] .tool-inbox-address { color: #e8b0b8; }
.tool-inbox[data-tool-dress="red"] .tool-inbox-flag {
  background: #e07080; color: #1a080c; border: 1px solid rgba(60, 20, 28, 0.4);
}
