/* fax · plain */
.tool-fax[data-tool-dress="plain"] .tool-fax-shell,
.tool-fax-shell {
  background: linear-gradient(165deg, #2a3038 0%, #1c2026 100%);
  border: 1px solid #3a424c;
  color: #c4ccd6;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
}
.tool-fax-brand {
  color: #8a94a0;
}
.tool-fax-word {
  color: #e8b060;
}
.tool-fax-sub {
  color: #9aa4b0;
}
.tool-fax-dest {
  background: #12151a;
  color: #e0c090;
  border: 1px solid #4a4030;
}
.tool-fax-dest:hover {
  border-color: #e0a050;
  color: #f0d0a0;
}
.tool-fax-hint {
  color: #6a7480;
}
