/* hermes · the.lover */
.tool-inbox[data-tool-dress="blue"] .tool-inbox-shell {
  background: linear-gradient(165deg, #3a6a9a 0%, #1e3a68 48%, #0c1e3a 100%);
  border: 1px solid rgba(8, 20, 40, 0.8);
  box-shadow:
    inset 0 1px 0 rgba(180, 210, 255, 0.18),
    2px 5px 14px rgba(0, 0, 0, 0.45);
}
.tool-inbox[data-tool-dress="blue"] .tool-inbox-slot {
  background: #060a14;
  border: 1px solid rgba(0, 0, 0, 0.55);
  box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.7);
}
.tool-inbox[data-tool-dress="blue"] .tool-inbox-word { color: #c8dcf0; }
.tool-inbox[data-tool-dress="blue"] .tool-inbox-sub { color: #f0f6fc; }
.tool-inbox[data-tool-dress="blue"] .tool-inbox-count { color: #e8d090; }
.tool-inbox[data-tool-dress="blue"] .tool-inbox-address { color: #a8c8e8; }
.tool-inbox[data-tool-dress="blue"] .tool-inbox-flag {
  background: #70a0e0; color: #0a1428; border: 1px solid rgba(20, 40, 80, 0.4);
}
