/* stamper tool dress · plain wood */
.tool-stamper[data-tool-dress="plain"] .tool-stamper-body {
  background: linear-gradient(165deg, #8a6a48 0%, #6a4a30 50%, #4a3220 100%);
  border: 1px solid rgba(40, 28, 16, 0.5);
  box-shadow:
    inset 0 1px 0 rgba(255, 220, 160, 0.2),
    2px 4px 10px rgba(0, 0, 0, 0.35);
}
.tool-stamper[data-tool-dress="plain"] .tool-stamper-knob {
  background: radial-gradient(circle at 35% 30%, #c4a070 0%, #5a4028 100%);
  border: 1px solid rgba(30, 20, 10, 0.4);
}
.tool-stamper[data-tool-dress="plain"] .tool-stamper-handle {
  background: #3a2818;
  border: 1px solid rgba(20, 12, 6, 0.45);
}
.tool-stamper[data-tool-dress="plain"] .tool-stamper-collar {
  background: linear-gradient(180deg, #7a5a38 0%, #4a3220 100%);
  border: 1px solid rgba(30, 20, 10, 0.4);
}
.tool-stamper[data-tool-dress="plain"] .tool-stamper-plate {
  background: #2a2018;
  color: #f0e0c8;
}
.tool-stamper[data-tool-dress="plain"] .tool-stamper-plate-rim {
  border-color: rgba(200, 170, 120, 0.18);
}
