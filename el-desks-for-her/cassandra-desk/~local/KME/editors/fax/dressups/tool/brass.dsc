/* fax · brass Chester plate */
.tool-fax[data-tool-dress="brass"] .tool-fax-shell {
  background: linear-gradient(165deg, #3a3428 0%, #221e16 55%, #1a1712 100%);
  border: 1px solid #6a5a38;
  color: #e8dcc0;
  box-shadow:
    inset 0 1px 0 rgba(255, 220, 140, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.35);
}
.tool-fax[data-tool-dress="brass"] .tool-fax-brand {
  color: #b09050;
}
.tool-fax[data-tool-dress="brass"] .tool-fax-word {
  color: #f0c860;
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.4);
}
.tool-fax[data-tool-dress="brass"] .tool-fax-sub {
  color: #c4a060;
}
.tool-fax[data-tool-dress="brass"] .tool-fax-dest {
  background: #12100c;
  color: #f0d080;
  border: 1px solid #8a7038;
}
.tool-fax[data-tool-dress="brass"] .tool-fax-dest:hover {
  border-color: #f0c860;
  background: #1a1610;
}
.tool-fax[data-tool-dress="brass"] .tool-fax-hint {
  color: #8a7a50;
}
