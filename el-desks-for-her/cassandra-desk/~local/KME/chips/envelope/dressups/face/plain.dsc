/* plain · default physical black packet + paper label (inherits _base) */
/* intentionally light — base is the object; this dress keeps id "plain" */
.nb-win.kind-deck[data-face="plain"] .env-label {
  /* slightly warmer paper */
  background: linear-gradient(165deg, #f4ead8 0%, #eadfca 55%, #e0d4bc 100%);
}
