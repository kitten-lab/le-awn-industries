/* costume · karaoke desk (default) */
.tool-karaoke[data-tool-dress="karaoke"] {
  background: linear-gradient(165deg, #2a2430 0%, #1a1620 50%, #121018 100%);
  border: 2px solid #3a3040;
  box-shadow:
    0 3px 0 #0a080c,
    0 5px 12px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}
.tool-karaoke[data-tool-dress="karaoke"] .tool-karaoke-tag {
  color: #f0e0c8;
  background: #a02848;
  box-shadow: 1px 1px 0 #400818;
}
.tool-karaoke[data-tool-dress="karaoke"] .tool-karaoke-lever {
  background: linear-gradient(180deg, #c04060, #801830);
  box-shadow: 0 2px 0 #401018;
}
.tool-karaoke[data-tool-dress="karaoke"] .tool-karaoke-copy {
  background: linear-gradient(180deg, #d0a040, #906018);
  box-shadow: 0 2px 0 #403010;
}
.tool-karaoke[data-tool-dress="karaoke"] .tool-karaoke-meta {
  color: #a898a0;
}
