/* eraser dress · pink rubber */
.tool-eraser[data-tool-dress="pink"] .tool-eraser-body {
  background: linear-gradient(165deg, #f0a8b8 0%, #d87890 45%, #b85870 100%);
  border: 1px solid rgba(80, 30, 40, 0.4);
}
.tool-eraser[data-tool-dress="pink"] .tool-eraser-band {
  background: linear-gradient(180deg, #f8c8d4 0%, #e090a4 100%);
  border-bottom: 1px solid rgba(80, 30, 40, 0.2);
}
.tool-eraser[data-tool-dress="pink"] .tool-eraser-block {
  color: #3a1820;
  text-shadow: 0 1px 0 rgba(255, 230, 236, 0.35);
}
.tool-eraser[data-tool-dress="pink"] .tool-eraser-edge {
  background: linear-gradient(180deg, #c86880 0%, #a04058 100%);
  border-top: 1px solid rgba(40, 16, 22, 0.25);
}
