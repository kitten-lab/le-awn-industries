/* deck · kraft / darker envelope */
.nb-win.kind-deck .env-flap {
  background: linear-gradient(180deg, #d4b878 0%, #c4a468 55%, #b89458 100%);
}
.nb-win.kind-deck .env-body {
  background: linear-gradient(165deg, #e0c890 0%, #d0b878 45%, #c0a868 100%);
}
.nb-win.kind-deck .deck-open {
  background: linear-gradient(180deg, #e2cc94 0%, #d4bc84 40%, #c8ae74 100%);
}
